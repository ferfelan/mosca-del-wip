{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(cerebro|img|video|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/Mosca-del-WIP-Informe.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Informe.pdf\"" }
      ]
    },
    {
      "source": "/Mosca-del-WIP-Report.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Report.pdf\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Manual.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Taller - Manual del facilitador.pdf\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Presentacion.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Taller - Presentacion.pdf\"; filename*=UTF-8''Mosca%20del%20WIP%20-%20Taller%20-%20Presentaci%C3%B3n.pdf" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Presentacion.pptx",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Mosca del WIP - Taller - Presentacion.pptx\"; filename*=UTF-8''Mosca%20del%20WIP%20-%20Taller%20-%20Presentaci%C3%B3n.pptx" }
      ]
    }
  ]
}
