{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mosca-del-wip\\.vercel\\.app" }],
      "destination": "https://mosca.deliverycraft.ai/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mosca-del-wip-ferfelans-projects\\.vercel\\.app" }],
      "destination": "https://mosca.deliverycraft.ai/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(cerebro|img|video|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/datos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/datos/mosca-del-wip-1-a-10-tareas.csv",
      "headers": [{ "key": "Link", "value": "<https://mosca.deliverycraft.ai/limite-wip/#datos>; rel=\"canonical\"" }]
    },
    {
      "source": "/datos/mosca-del-wip-urgencias.csv",
      "headers": [{ "key": "Link", "value": "<https://mosca.deliverycraft.ai/limite-wip/#datos>; rel=\"canonical\"" }]
    },
    {
      "source": "/datos/mosca-del-wip-1-to-10-tasks.csv",
      "headers": [{ "key": "Link", "value": "<https://mosca.deliverycraft.ai/en/wip-limit/#datos>; rel=\"canonical\"" }]
    },
    {
      "source": "/datos/mosca-del-wip-urgent-tasks.csv",
      "headers": [{ "key": "Link", "value": "<https://mosca.deliverycraft.ai/en/wip-limit/#datos>; rel=\"canonical\"" }]
    },
    {
      "source": "/Mosca-del-WIP-Informe.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Informe.pdf\"" }
      ]
    },
    {
      "source": "/Mosca-del-WIP-Report.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Report.pdf\"" }
      ]
    },
    {
      "source": "/Mosca-del-WIP-Resumen.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Resumen.pdf\"" },
        { "key": "Link", "value": "<https://mosca.deliverycraft.ai/informe/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/Mosca-del-WIP-Summary.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Summary.pdf\"" },
        { "key": "Link", "value": "<https://mosca.deliverycraft.ai/en/report/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Guia-rapida.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Taller - Guia rapida del facilitador.pdf\"; filename*=UTF-8''Mosca%20del%20WIP%20-%20Taller%20-%20Gu%C3%ADa%20r%C3%A1pida%20del%20facilitador.pdf" },
        { "key": "Link", "value": "<https://mosca.deliverycraft.ai/taller/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Presentacion.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Taller - Presentacion.pdf\"; filename*=UTF-8''Mosca%20del%20WIP%20-%20Taller%20-%20Presentaci%C3%B3n.pdf" },
        { "key": "Link", "value": "<https://mosca.deliverycraft.ai/taller/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Hoja-del-equipo.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Mosca del WIP - Taller - Hoja del equipo.pdf\"" },
        { "key": "Link", "value": "<https://mosca.deliverycraft.ai/taller/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/taller/Mosca-del-WIP-Taller-Presentacion.pptx",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Mosca del WIP - Taller - Presentacion.pptx\"; filename*=UTF-8''Mosca%20del%20WIP%20-%20Taller%20-%20Presentaci%C3%B3n.pptx" }
      ]
    }
  ]
}
